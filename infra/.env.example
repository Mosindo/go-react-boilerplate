# ---------------------------------------------------------------------------
# Lueur — environment variables (copy to .env and adjust). Never commit .env.
# ---------------------------------------------------------------------------

# development | test | production. Production requires SMTP_* (account recovery).
APP_ENV=development

# Required. Generate with: openssl rand -hex 32  (>= 32 chars, no placeholder words)
JWT_SECRET=

# API port inside the container / process (Docker publishes it on 18080).
PORT=8080

# Required when running the API outside Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Optional: Postgres password used by docker-compose.
POSTGRES_PASSWORD=postgres

# Comma-separated browser origins allowed by CORS (Expo web dev server, web app).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted.
# Leave empty when the API is exposed directly (rate limits then use the socket IP).
TRUSTED_PROXIES=

# Where profile photos are stored (a persistent volume in Docker).
UPLOAD_DIR=./data/uploads

# SMTP relay for password-reset codes. When SMTP_HOST is empty (development),
# codes are printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Mobile app (apps/mobile): public API base URL baked into the build.
# Physical phone: http://<LAN_IP>:18080 — never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
