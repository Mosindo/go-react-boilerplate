# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- API --------------------------------------------------------------------
# development | test | production. Production requires SMTP and refuses the
# demo seed.
APP_ENV=development
# Strong random secret, 32+ characters: openssl rand -base64 48
JWT_SECRET=
# Only needed when running the API outside Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080
# Where uploaded photos are stored (mounted as a volume in Docker).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS (web client). Native apps
# do not need it.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when the API is exposed directly (rate limits use the peer IP).
TRUSTED_PROXIES=

# --- Email (password recovery) ----------------------------------------------
# Docker Compose defaults to the bundled Mailpit catcher (UI on :8025).
# Outside Docker in development, leaving SMTP_HOST empty prints emails in the
# API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker Postgres ----------------------------------------------------------
POSTGRES_PASSWORD=postgres

# --- Mobile app (apps/mobile) -------------------------------------------------
# Public, baked into the app bundle: never put secrets in EXPO_PUBLIC_* vars.
# Physical phone: use your machine's LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080

# --- Demo seed (development only) ---------------------------------------------
SEED_PASSWORD=DemoPass123
