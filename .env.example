# Copy to .env and fill in. Never commit the real file.

# --- Required -----------------------------------------------------------
# Generate with: openssl rand -hex 32   (>= 32 chars, placeholders are rejected)
JWT_SECRET=
# Used by docker compose for the bundled PostgreSQL container.
POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------
# Needed when running the API outside Docker (docker compose builds it for you).
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/app?sslmode=disable
PORT=8080
# Host port published by docker compose.
API_HOST_PORT=18080
# Where uploaded photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS / WebSocket (web client only).
ALLOWED_ORIGINS=
# "production" makes the demo seed refuse to run.
APP_ENV=development

# --- Account recovery email (optional but needed for password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Development only: print recovery codes in the API log when SMTP is not set.
LOG_RESET_CODES=false

# --- Mobile (apps/mobile/.env, read by Expo) ------------------------------
# Physical phone: use your computer's LAN IP, never localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
