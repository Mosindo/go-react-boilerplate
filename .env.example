# ── API (services/api) ────────────────────────────────────────────────────────
# Copy to .env (never commit it). Generate the secret with:  openssl rand -hex 32
JWT_SECRET=

# Runtime: development | test | production. Production refuses to start without SMTP and never logs
# recovery links.
APP_ENV=development

# Listening port inside the container/host (default 8080). docker-compose publishes it as 18080.
PORT=8080

# PostgreSQL connection string. In docker compose it is set for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Directory for uploaded photos (processed JPEGs). Mount a persistent volume in production.
UPLOAD_DIR=./data/uploads

# Browser origins allowed to call the API (comma separated). Only needed for the web build.
ALLOWED_ORIGINS=http://localhost:8081

# IPs/CIDRs of reverse proxies whose X-Forwarded-For header is trusted (rate limits use the client IP).
# Leave empty when the API is reached directly.
TRUSTED_PROXIES=

# Password recovery. {token} is replaced by the one-time token. Use your app's deep link in production,
# e.g. lueur://reset-password?token={token} or https://app.example.com/reset-password?token={token}
PASSWORD_RESET_URL=http://localhost:8081/reset-password?token={token}

# SMTP for recovery emails. Empty in development: the link is printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Mobile app (apps/mobile) ──────────────────────────────────────────────────
# URL of the API as seen from the device. Never "localhost" on a physical phone: use the LAN IP of the
# machine running the API, e.g. http://192.168.1.20:18080. Required for release builds.
EXPO_PUBLIC_API_URL=

# ── Demo data (go run ./cmd/seed) ─────────────────────────────────────────────
# Password of the demo accounts and the centre of their positions (defaults: Paris).
SEED_PASSWORD=demo-password-123
SEED_LAT=48.8566
SEED_LNG=2.3522
