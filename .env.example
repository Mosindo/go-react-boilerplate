# Copy to .env (never commit .env). Docker Compose reads this file automatically.

# --- API --------------------------------------------------------------------
# development | production | test. Production requires SMTP (password reset).
APP_ENV=development
# REQUIRED. Random secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# Host port mapped to the API container (the API listens on 8080 inside).
API_HOST_PORT=18080
# Browser origins allowed by CORS (comma separated). Native apps send no Origin.
ALLOWED_ORIGINS=http://localhost:8081
# Reverse proxies whose X-Forwarded-For header is trusted (comma separated IPs/CIDRs).
# Leave empty when the API is exposed directly; rate limiting relies on it.
TRUSTED_PROXIES=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_HOST_PORT=5432
# Used when running the API, the seed or the tests outside Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Optional dedicated database for `go test` integration tests:
DATABASE_URL_TEST=

# --- Photos -----------------------------------------------------------------
# Directory where processed photos are stored (a Docker volume in Compose).
UPLOAD_DIR=./data/uploads

# --- Email (password reset codes) -------------------------------------------
# Without SMTP in development, emails are printed to the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Demo seed (local only, refused when APP_ENV=production) ----------------
DEMO_PASSWORD=DemoLueur2026
