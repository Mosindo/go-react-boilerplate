# Copy to .env and fill in. Never commit the real file.

# --- Required -------------------------------------------------------------
# Generate with: openssl rand -hex 32  (>= 32 chars, not a placeholder)
JWT_SECRET=

# Local (host) run. Docker Compose builds its own DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# --- Optional -------------------------------------------------------------
# development | production | test. Production requires SMTP and disables the seed.
APP_ENV=development
PORT=8080
# Where photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Public base URL, used in password reset emails.
APP_BASE_URL=http://localhost:18080
# Comma-separated browser origins allowed by CORS (only needed for the web build).
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=
# Password used by docker compose for the bundled Postgres.
POSTGRES_PASSWORD=postgres

# SMTP for password reset emails. Without it (development only) emails are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Seed (go run ./cmd/seed, development only) ---------------------------
# SEED_PASSWORD=DemoPass1234!
# SEED_LAT=48.8566
# SEED_LON=2.3522

# --- Mobile (apps/mobile/.env) --------------------------------------------
# Never use localhost on a physical phone: use your machine's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
