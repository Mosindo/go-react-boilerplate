# Copy to .env (never commit .env). Used by docker compose and `go run ./cmd/api`.

# --- Required -------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Local `go run`: postgres://app:app@localhost:5432/app?sslmode=disable
# Docker Compose builds this URL itself.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# --- Optional ---------------------------------------------------------------
PORT=8080
# development | test | production (default production). Development enables the
# permissive CORS default, logs reset codes instead of e-mailing them and allows `cmd/seed`.
APP_ENV=development
# Comma separated browser origins allowed to call the API (Expo web, admin...).
# Empty = no cross-origin access in production, any origin in development.
ALLOWED_ORIGINS=
# Comma separated proxy IPs/CIDRs whose X-Forwarded-For can be trusted (your load balancer).
TRUSTED_PROXIES=
# Where uploaded photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
POSTGRES_PASSWORD=app

# Password-reset e-mails. Without SMTP_HOST nothing is delivered in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lumo <no-reply@example.org>

# Demo data (go run ./cmd/seed): shared password of the demo accounts.
SEED_PASSWORD=DemoPass123!
