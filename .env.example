# ---- API (services/api) ----
# development | test | production. Production enables release mode and
# refuses to print password-reset codes or to run the demo seed.
APP_ENV=development
# Required. Generate with: openssl rand -hex 32   (>= 32 chars, no placeholder words)
JWT_SECRET=
PORT=8080
# Required. Docker Compose sets it automatically for the api container.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Where photos are stored on disk (a Docker volume in compose).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS (e.g. Expo web: http://localhost:8081).
ALLOWED_ORIGINS=
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting by IP).
TRUSTED_PROXIES=
# Outgoing e-mail for account recovery. Without SMTP_HOST, codes are printed in the API logs (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Mobile app (apps/mobile) ----
# Public, non-secret. Use your LAN IP on a physical phone, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
