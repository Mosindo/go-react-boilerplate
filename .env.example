# Copy to .env and fill in. Never commit the real file.

# --- API (services/api) ---------------------------------------------------------
# development | test | production. In production SMTP_* is mandatory.
APP_ENV=development
PORT=8080
# Used by `go run` / tests. Docker Compose builds its own URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=app
# Random value, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
APP_NAME=Lien
# Where processed photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS/WebSocket (web builds only).
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = trust none).
TRUSTED_PROXIES=

# --- Account recovery email (leave SMTP_HOST empty in development: codes are logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile (apps/mobile) -------------------------------------------------------
# Physical phones cannot reach localhost: use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
