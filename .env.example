# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- API (required) ---------------------------------------------------------
# Strong random secret, >= 32 chars:  openssl rand -hex 32
JWT_SECRET=
# development | test | production (production hides demo accounts and requires SMTP)
APP_ENV=development
# Used when running the API outside Docker (Docker Compose builds its own URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080
# Where processed photos are stored (a persistent volume in production).
UPLOAD_DIR=./data/uploads

# --- API (optional) ---------------------------------------------------------
# Browser origins allowed for CORS and WebSocket (web build / Expo web dev server).
ALLOWED_ORIGINS=http://localhost:8081
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting per client IP).
TRUSTED_PROXIES=
# Account recovery emails. Without SMTP_HOST (dev only), codes are written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Postgres password used by docker-compose.yml.
POSTGRES_PASSWORD=postgres

# --- Mobile / web app (apps/mobile) -----------------------------------------
# Public API URL baked into the app. On a physical phone use your LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
