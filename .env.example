# Copy to .env (never commit .env). Used by docker compose and by `go run ./cmd/api`.

# --- Required -----------------------------------------------------------------
# Generate with: openssl rand -hex 32   (>= 32 chars; placeholder-looking values are rejected)
JWT_SECRET=
# Used when running the API outside Docker. Docker Compose sets its own value.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# --- Optional -----------------------------------------------------------------
PORT=8080
# development | production. Production requires SMTP_HOST and disables the demo seed.
APP_ENV=development
# Comma-separated browser origins allowed by CORS / WebSocket (native apps do not need it).
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (rate limiting uses the client IP).
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# Password-reset e-mails. Without SMTP_HOST (development only) the code is written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Seed password for demo accounts (`go run ./cmd/seed`). Never used in production.
DEMO_PASSWORD=
