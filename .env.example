# Copy to .env (never commit it). Used by `docker compose` and by the API when run locally.

# --- Required -----------------------------------------------------------------
# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=

# --- API ----------------------------------------------------------------------
APP_ENV=development
PORT=8080
# Local run without Docker (compose sets this itself):
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable
# Where photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Public URL of the app/API, used in password-reset emails. Required in production.
APP_BASE_URL=
# Comma separated browser origins allowed for CORS and WebSocket (web build only). Native apps need nothing.
ALLOWED_ORIGINS=
# Comma separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=
# Max upload size for one photo, bytes (default 8388608).
MAX_PHOTO_BYTES=

# --- Email (password recovery). Required when APP_ENV=production ---------------
# In development, emails are printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Tests ----------------------------------------------------------------------
# A DISPOSABLE database: the integration tests drop and recreate its public schema.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/app_test?sslmode=disable
