# Copy to .env (never commit .env) and adjust. Docker Compose reads this file automatically.

# --- Required -----------------------------------------------------------------
# Random secret, 32 characters minimum. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- API ----------------------------------------------------------------------
# development | test | production. Production refuses to start without SMTP_HOST.
APP_ENV=development
PORT=8080
# Used when running the API outside Docker (docker-compose.yml sets its own).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=postgres
# Where processed photos are stored (a Docker volume in compose).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed to call the API (web build). Native apps need none.
ALLOWED_ORIGINS=
# Comma-separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=

# --- Account recovery emails ----------------------------------------------------
# Without SMTP_HOST the API prints recovery emails to its log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost
# Optional: link added to the recovery email (the token is appended as ?token=...).
PASSWORD_RESET_URL=

# --- Mobile app (build-time, public: never put secrets here) ------------------
# Physical phone: use your computer's LAN IP, never localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
