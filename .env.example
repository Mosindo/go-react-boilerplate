# Copy to .env (never commit .env). Used by `docker compose` and for local `go run`.

# REQUIRED: random string, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# development | production (default when unset). Only "development" logs password reset codes and allows seeding demo data.
APP_ENV=development

# Local development without Docker (go run ./cmd/api inside services/api):
# DATABASE_URL=postgres://ember:ember@localhost:5432/ember?sslmode=disable
# PORT=8080
# UPLOAD_DIR=./data/uploads

# Docker Compose database password (change it outside local development).
# POSTGRES_PASSWORD=ember

# Comma separated browser origins allowed to call the API / open the WebSocket (web builds only).
# Native apps send no Origin header and need nothing here.
# ALLOWED_ORIGINS=https://app.example.com

# Comma separated reverse-proxy IPs/CIDRs whose X-Forwarded-For header is trusted (rate limiting).
# Leave empty when the API is exposed directly.
# TRUSTED_PROXIES=10.0.0.0/8
