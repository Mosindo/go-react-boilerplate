# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- API -------------------------------------------------------------------
# development | test | production. Production requires SMTP and refuses demo seeding.
APP_ENV=development
# Required. Random secret of at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Port the API listens on (inside the container, or locally with `go run`).
PORT=8080
# Only needed when running the API outside Docker (Compose builds it from POSTGRES_*).
DATABASE_URL=postgres://lueur:lueur-local-only@localhost:5432/lueur?sslmode=disable
# Comma-separated browser origins allowed by CORS and WebSocket (native apps send no Origin).
ALLOWED_ORIGINS=http://localhost:8081
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXIES=
# Photo storage directory when running outside Docker.
UPLOAD_DIR=./data/uploads

# --- Password-reset e-mails (required in production) ------------------------
# Without SMTP_HOST, reset codes are written to the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Local PostgreSQL (Docker Compose only) ----------------------------------
POSTGRES_USER=lueur
POSTGRES_PASSWORD=lueur-local-only
POSTGRES_DB=lueur

# --- Demo seed (never in production) -----------------------------------------
# Password of the demo accounts (default: DemoPassword1).
SEED_PASSWORD=
# Optional: e-mail of an existing account that every demo member will like.
SEED_LIKE_EMAIL=
SEED_LATITUDE=48.8566
SEED_LONGITUDE=2.3522
