# Copy to `.env` (never commit it). Docker Compose reads this file automatically.

# --- Required -------------------------------------------------------------
# Random secret, at least 32 characters:  openssl rand -hex 32
JWT_SECRET=

# --- API / database ---------------------------------------------------------
# Used by `go run ./cmd/api` outside Docker (compose builds its own URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080
# Host port published by docker compose (mobile app default: 18080).
API_HOST_PORT=18080
# Compose database credentials (change them for anything but local dev).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- Web / CORS ---------------------------------------------------------------
# Public URL of the web client (used in password-reset emails).
APP_BASE_URL=http://localhost:8081
# Comma-separated browser origins allowed to call the API (web build only;
# native apps do not send an Origin header). Example: https://app.example.com
ALLOWED_ORIGINS=http://localhost:8081

# Reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For (drives rate limiting).
# Leave empty when the API is exposed directly. Example: 10.0.0.0/8
TRUSTED_PROXIES=

# --- Email (optional) ---------------------------------------------------------
# Without SMTP_HOST, password-reset emails are printed in the API log (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Misc ---------------------------------------------------------------------
# `production` makes `cmd/seed` refuse to run.
APP_ENV=development

# --- Mobile (apps/mobile/.env, baked in at build time; contains no secret) ----
# Physical phone: use your LAN IP, never localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
