# Copy to .env (never commit .env). Docker Compose reads it automatically.

# REQUIRED. Random secret, at least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# development | production. In production SMTP_HOST is mandatory and the demo seed refuses to run.
APP_ENV=development

# Database password used by docker compose (change it outside local development).
POSTGRES_PASSWORD=postgres

# Used by `go run` outside Docker (compose builds its own DATABASE_URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080

# Where private photo files are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS (only needed for web builds). Native apps do not need it.
ALLOWED_ORIGINS=

# Reverse-proxy IPs/CIDRs trusted for X-Forwarded-For (used for per-IP rate limiting). Empty = trust none.
TRUSTED_PROXIES=

# Password-recovery emails. Leave SMTP_HOST empty in development: codes are printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Mobile app (apps/mobile/.env) ---
# URL of the API as seen by the device. A physical phone cannot use localhost: use your LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
