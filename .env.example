# Copy to .env. Never commit real values.
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app?sslmode=disable

# development | test | production (production requires SMTP_HOST and SMTP_FROM)
APP_ENV=development
# Comma separated browser origins allowed for CORS and WebSocket (native apps send no Origin)
ALLOWED_ORIGINS=

# Password reset emails. Leave SMTP_HOST empty in development to log them instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
