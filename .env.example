# ---------------------------------------------------------------------------
# Seren — environment variables. Copy to `.env` (never commit `.env`).
# Docker Compose reads this file automatically from the repository root.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# Required. Generate with: openssl rand -hex 32   (min. 32 chars, no placeholder)
JWT_SECRET=

# API listen port inside the container / process.
PORT=8080

# Required when running the API outside Docker.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Postgres credentials used by docker-compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Comma-separated browser origins allowed by CORS / WebSocket (Expo web dev server).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted.
# Leave empty when the API is reached directly.
TRUSTED_PROXIES=

# Where photos are stored on disk.
UPLOAD_DIR=./data/uploads

# Optional SMTP for password-reset e-mails. Without SMTP, development builds
# print the reset code in the API logs; production refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Mobile app (apps/mobile): public API URL baked into the client bundle.
# Use your LAN IP on a physical phone, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
