# ---------------------------------------------------------------------------
# API (services/api) — copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# REQUIRED. At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# HTTP port inside the container / process (default 8080).
PORT=8080

# REQUIRED when running the API outside Docker Compose.
# Compose builds it from POSTGRES_* below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Where photos are stored (Docker: /data/uploads volume).
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS (only needed for the web build).
ALLOWED_ORIGINS=

# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted.
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# Account recovery e-mails. Without SMTP_HOST, codes are printed in the API
# logs in development and not sent at all in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Docker Compose database credentials (local development defaults).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Password of the demo accounts created by `go run ./cmd/seed` (dev only).
SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — public build-time values only, never secrets.
# ---------------------------------------------------------------------------
# Physical phone: use your machine's LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
