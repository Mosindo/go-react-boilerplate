# Copy to .env (never commit it). Docker Compose reads this file automatically.

# --- Required ---------------------------------------------------------------
# Random secret of at least 32 characters, e.g.:  openssl rand -base64 48
JWT_SECRET=

# --- API ---------------------------------------------------------------------
# "development" (default) logs password-recovery codes instead of emailing them.
# "production" requires SMTP_HOST/SMTP_FROM and Gin release mode.
APP_ENV=development
PORT=8080
# Used by `go run ./cmd/api` outside Docker. Compose builds its own URL from POSTGRES_*.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Comma-separated browser origins allowed to call the API (web build), e.g. https://app.example.com
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted (rate limiting uses the client IP).
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# --- Database (docker compose) ----------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Email (password recovery). Optional in development. --------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
