# Copy to .env and fill in. Never commit .env.

# ---- Database (used by docker compose) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=app

# ---- API ----
# development | production. Production requires SMTP_HOST and APP_BASE_URL.
APP_ENV=development
# Required. At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=
# Host port mapped to the API container (physical phones: use http://<LAN_IP>:18080).
API_HOST_PORT=18080
# Public URL of the API/web app (required in production).
APP_BASE_URL=
# Comma separated browser origins allowed to call the API (web build only).
ALLOWED_ORIGINS=
# Comma separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXIES=

# ---- Password recovery e-mails (optional in development) ----
# Without SMTP_HOST the reset code is printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Local (non-Docker) runs ----
# DATABASE_URL=postgres://app:change-this-database-password@localhost:5432/app?sslmode=disable
# PORT=8080

# ---- Mobile app (apps/mobile) ----
# Base URL of the API as seen from the phone/emulator. Never use localhost on a physical phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
