# Copy to .env and fill in. Never commit .env.

# --- API ---------------------------------------------------------------
# development | test | production (production requires SMTP_*)
APP_ENV=development
# Generate with: openssl rand -base64 48   (min. 32 chars, no placeholder)
JWT_SECRET=
# Only needed when running the API outside Docker.
DATABASE_URL=postgres://lueur:<password>@localhost:5432/lueur?sslmode=disable
PORT=8080
# Where photos are stored (Docker uses a named volume at /app/data).
UPLOAD_DIR=./data/uploads
# Browser origins allowed for CORS + WebSocket (Expo web dev server: 8081).
ALLOWED_ORIGINS=http://localhost:8081
# Reverse proxies whose X-Forwarded-For is trusted (comma separated IPs/CIDRs).
TRUSTED_PROXIES=

# --- Password reset e-mails (required in production) -------------------
# Without SMTP, reset codes are printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker Compose ----------------------------------------------------
POSTGRES_USER=lueur
POSTGRES_PASSWORD=
POSTGRES_DB=lueur
API_HOST_PORT=18080
