# ---------------------------------------------------------------------------
# Lueur API — copy to .env (never commit .env) and adjust.
# ---------------------------------------------------------------------------

# development | production | test. "production" disables the dev mail
# fallback and demo seeding; "test" disables rate limits (automated tests).
APP_ENV=development

# Required. Generate with: openssl rand -base64 48
# Placeholder-looking values are rejected at startup.
JWT_SECRET=

PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable

# Private directory where processed photos are stored (never served directly).
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS (web client). Native apps
# do not need it.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated reverse proxies/CIDRs trusted for X-Forwarded-For. Leave
# empty when the API is exposed directly (rate limits then use the peer IP).
TRUSTED_PROXIES=

# SMTP relay for password-reset codes. Without it, codes are printed in the
# API log in development, and password reset is disabled in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — only public values, never secrets.
# ---------------------------------------------------------------------------
# Physical phone: use your LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
