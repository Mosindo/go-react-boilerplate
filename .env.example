# --- API (services/api) -------------------------------------------------------
# Required. Generate one with: openssl rand -hex 32   (32+ chars, never a placeholder)
JWT_SECRET=
# Required outside docker compose (compose sets it for you).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080
# Where processed photos are stored. Mount a persistent volume in production.
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS / WebSocket (web clients only).
ALLOWED_ORIGINS=
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
# Leave empty when the API is directly exposed.
TRUSTED_PROXIES=
# DEVELOPMENT ONLY: log password-reset tokens instead of e-mailing them.
MAIL_LOG_TOKENS=false
# `go run ./cmd/seed` refuses to run when APP_ENV=production.
APP_ENV=development
# Optional: password of the demo accounts created by the seed (default DemoPass123!).
DEMO_PASSWORD=

# --- Mobile (apps/mobile) -----------------------------------------------------
# Put these in apps/mobile/.env (Expo reads EXPO_PUBLIC_* at build time). They are public: never put secrets here.
# Physical phone: use your computer's LAN IP, never localhost.   e.g. http://192.168.1.20:18080
EXPO_PUBLIC_API_URL=http://localhost:18080
EXPO_PUBLIC_APP_NAME=Mellow
