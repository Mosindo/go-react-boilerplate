# ---- API (services/api) -------------------------------------------------------
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
# Required when running the API outside Docker Compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Docker Compose only: password of the bundled Postgres.
POSTGRES_PASSWORD=postgres
PORT=8080
# Directory for uploaded photos (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS and WebSocket (native apps do not need this).
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (empty = trust none).
TRUSTED_PROXIES=
# Optional SMTP for password-recovery emails. Without SMTP_HOST, codes are printed in the API log (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
# Set to "production" to make `cmd/seed` refuse to run.
APP_ENV=

# ---- Tests ---------------------------------------------------------------------
# Postgres database used by `go test` (each test creates and drops its own schema).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test?sslmode=disable

# ---- Mobile app (apps/mobile) --------------------------------------------------
# Public, non-secret. Use your LAN IP for a physical phone, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
