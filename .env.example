# --- API (services/api) -----------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=8080
# Local run (API on the host, Postgres from docker compose):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# development | production (production hides dev-only behaviour such as logging mails)
APP_ENV=development
# Directory for uploaded photos (use a persistent volume, or implement storage.Storage for S3)
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed to call the API (web build only; native apps need none)
ALLOWED_ORIGINS=
# Reverse proxies whose X-Forwarded-For is trusted for client IPs (rate limiting). Empty = trust none.
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

# Password recovery mail. Without SMTP_HOST, codes are only logged when APP_ENV is not production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker compose (optional overrides) -------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- Mobile app (apps/mobile) ------------------------------------------------
# Public by design (bundled in the app): never put secrets in EXPO_PUBLIC_* variables.
# Physical phone: use your machine's LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
