# Copy to .env (never commit it). Used by docker-compose.yml and as a reference for local runs.

# Required: random secret, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# development | production. Production requires SMTP_* (password recovery emails) and hides gin debug output.
APP_ENV=development

# Docker Compose only: database password (defaults to "app" for local development).
POSTGRES_PASSWORD=app

# Local `go run` only (Docker Compose builds its own URL):
# DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable
# PORT=8080

# Browser origins allowed to call the API (comma separated). Needed for the web build, not for native apps.
ALLOWED_ORIGINS=

# Reverse proxy addresses/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# Max login/register/reset calls per IP per 10 minutes.
AUTH_RATE_LIMIT=30

# Password recovery emails. Without SMTP_HOST (development only) the code is printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
