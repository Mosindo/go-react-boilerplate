# Copy to `.env` (never commit it). Docker Compose reads this file automatically.

# --- Required -------------------------------------------------------------
# Signs access tokens and photo URLs. 32+ random characters, e.g. `openssl rand -hex 32`.
# Placeholder-looking values are rejected at startup on purpose.
JWT_SECRET=

# --- API ------------------------------------------------------------------
# development | production. Production disables the dev mailer and the seed command.
APP_ENV=development
PORT=8080
# Only needed when running the API outside Docker Compose (compose sets it for you).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# Where uploaded photos are stored (a volume in Docker).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed to call the API (web clients). Native apps need none.
ALLOWED_ORIGINS=
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For can be trusted (rate limiting by IP).
TRUSTED_PROXIES=

# --- Account recovery email (optional in development) ---------------------
# Without SMTP_HOST, development logs the recovery code to the API output and
# production sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile app (apps/mobile) ---------------------------------------------
# Set it in apps/mobile/.env or inline. A physical phone cannot reach `localhost`: use your LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
