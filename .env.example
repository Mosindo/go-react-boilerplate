# Copy to `.env` (never commit it). Used by docker compose and for local runs.

# --- Required -----------------------------------------------------------------
# Random secret, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=

# --- API ----------------------------------------------------------------------
# Local (non-Docker) run: postgres://app:app@localhost:5432/app?sslmode=disable
# docker compose builds its own DATABASE_URL.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
PORT=8080
# development | production. Production requires SMTP_* and disables the seed command.
APP_ENV=development
# Where photos are stored on disk (a Docker volume in compose).
UPLOAD_DIR=./data/uploads
# Browser origins allowed to call the API (comma separated). Native apps need none.
ALLOWED_ORIGINS=
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For can be trusted (comma separated).
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# --- Password recovery email (required when APP_ENV=production) ----------------
# Without SMTP_ADDR, recovery codes are only written to the API log (dev only).
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- docker compose only --------------------------------------------------------
POSTGRES_PASSWORD=app

# --- Tests (Go integration tests; the database is wiped!) -----------------------
# TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test?sslmode=disable
