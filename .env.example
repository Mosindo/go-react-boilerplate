# ── API (required) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (at least 32 characters, never commit it)
JWT_SECRET=
# Used when running the API outside Docker. Docker Compose builds its own URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080

# ── API (optional) ─────────────────────────────────────────────────────────
# development | production. In production SMTP_HOST is mandatory and the seed command refuses to run.
APP_ENV=development
# Comma-separated browser origins allowed by CORS (not needed for the native mobile app).
ALLOWED_ORIGINS=
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=

# ── Password-reset e-mails ─────────────────────────────────────────────────
# Without SMTP_HOST the code is written to the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Docker Compose database credentials (defaults shown) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# ── Seed (development only) ────────────────────────────────────────────────
DEMO_PASSWORD=demo-password-123

# ── Mobile app (apps/mobile/.env or shell) ─────────────────────────────────
# Physical phone: use your computer's LAN IP, never localhost.
# Android emulator: http://10.0.2.2:18080 — iOS simulator: http://localhost:18080
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
