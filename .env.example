# Copy to .env (never commit it) and fill in the values.
# Docker Compose reads this file automatically.

# --- API ---------------------------------------------------------------
# development | test | production. Production requires SMTP and hides debug output.
APP_ENV=development
# Strong random secret, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Postgres connection string (Compose builds it for the api container).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=postgres
# HTTP port inside the container / process (Compose publishes it on 18080).
PORT=8080
# Browser origins allowed by CORS and the realtime WebSocket (comma separated).
# Native apps send no Origin header and are always accepted.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Reverse proxies whose X-Forwarded-For header is trusted (comma separated IPs/CIDRs).
# Leave empty when the API is reached directly.
TRUSTED_PROXIES=
# Where photos are stored on disk.
UPLOAD_DIR=./data/uploads

# --- E-mail (password reset codes) -------------------------------------
# Leave SMTP_HOST empty in development: codes are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# --- Mobile app (apps/mobile/.env) -------------------------------------
# Public by design: never put secrets in EXPO_PUBLIC_* variables.
# Physical phone: use your computer's LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
