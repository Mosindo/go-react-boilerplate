# Copy to `.env` (never commit it). Used by docker compose and when running the API locally.

# ── Required ────────────────────────────────────────────────────────────────
# Random secret, 32+ characters:  openssl rand -base64 48
JWT_SECRET=

# Local runs only; docker compose builds its own DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# ── Optional ────────────────────────────────────────────────────────────────
APP_ENV=development            # "production" requires SMTP_* and disables the demo seed
PORT=8080
POSTGRES_PASSWORD=app          # change it anywhere the database is reachable by others
UPLOAD_DIR=./data/uploads      # private photo storage (a Docker volume in compose)
ALLOWED_ORIGINS=               # comma-separated web origins allowed by CORS, e.g. http://localhost:8081
TRUSTED_PROXIES=               # comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted

# Account-recovery emails. Empty SMTP_HOST = codes are only written to the server log (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
