# Copier vers .env (ne jamais committer .env). Utilise par docker-compose et la CLI.

# --- API (obligatoire) ---
# Secret HS256, >= 32 caracteres aleatoires. Generer: openssl rand -base64 48
JWT_SECRET=
# Chaine de connexion PostgreSQL (docker-compose la fournit deja a l'API)
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable
PORT=8080

# --- API (optionnel) ---
# development | production (production exige SMTP_HOST et desactive le seed)
APP_ENV=development
# Dossier de stockage des photos (hors racine web; monte en volume en Docker)
UPLOAD_DIR=./data/uploads
# Origines web autorisees (CORS + WebSocket navigateur), separees par des virgules
ALLOWED_ORIGINS=
# Proxys de confiance pour X-Forwarded-For (rate limiting par IP), ex: 10.0.0.0/8
TRUSTED_PROXIES=
# URL publique de l'app (lien dans l'email de recuperation)
APP_BASE_URL=

# --- Email (recuperation de mot de passe). Vide en dev: le code est ecrit dans les logs ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- docker-compose ---
POSTGRES_PASSWORD=app

# --- Mobile (apps/mobile/.env) ---
# JAMAIS localhost sur un telephone physique: utiliser l'IP LAN de la machine
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
