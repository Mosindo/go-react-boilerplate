# ---- Alba: environment variables --------------------------------------------
# Copy to .env (never commit .env). Docker Compose reads it automatically.

# REQUIRED. >= 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Runtime mode: "development" (default) or "production".
# Production refuses to start without SMTP_HOST (password reset needs real email).
APP_ENV=development

# API listen port inside the process (default 8080). Docker publishes it as 18080.
PORT=8080

# REQUIRED when running the API outside Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable

# Where photos are stored (private, served only through signed URLs).
UPLOAD_DIR=./data/uploads

# Public URL of the app/API, used to build password-reset links in emails.
APP_BASE_URL=http://localhost:18080

# Comma-separated browser origins allowed by CORS (Expo web only). Native apps need none.
ALLOWED_ORIGINS=

# Transactional email (password reset). Leave SMTP_HOST empty in development:
# the reset token is then written to the API log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Mobile (apps/mobile) ---------------------------------------------------
# Physical phone: NEVER use localhost. Use your machine's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
