# Copy to .env (never commit it). Docker Compose reads this file automatically.

# --- Required -------------------------------------------------------------
# Random secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# Used by docker-compose only (the API gets a ready-made DATABASE_URL).
POSTGRES_PASSWORD=postgres

# --- API (read from the process environment; set by docker-compose) --------
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
# PORT=8080
# development | production. In production SMTP_HOST is mandatory.
APP_ENV=development
# Directory for uploaded photos (a volume in Docker). Default ./data/uploads
# UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed for CORS / WebSocket (web builds only).
ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=

# --- Password recovery mail (required when APP_ENV=production) --------------
# Without SMTP_HOST in development, recovery codes are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Tests ----------------------------------------------------------------
# Enables the PostgreSQL integration tests (they create/drop throw-away schemas):
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# --- Mobile (apps/mobile/.env) ---------------------------------------------
# EXPO_PUBLIC_API_URL=http://<LAN_IP>:18080
