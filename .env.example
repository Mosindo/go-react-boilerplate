# Copy to `.env` (never commit it). Used by `docker compose --env-file .env -f infra/docker-compose.yml ...`
# and as a reference for running the API directly.

# --- Required -------------------------------------------------------------------------------
# Random secret, 32+ characters:  openssl rand -hex 32
JWT_SECRET=
# Postgres connection string. Docker Compose sets this for you; set it when running the API directly.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# --- Optional (defaults shown) --------------------------------------------------------------
PORT=8080
# "production" enforces SMTP and disables the seed command.
APP_ENV=development
# Where photos are stored (private, served only through signed API URLs). Back this directory up.
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed to call the API (web build only, not needed for native apps).
ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of your reverse proxy; only then X-Forwarded-For is trusted (rate limiting by client IP).
TRUSTED_PROXIES=

# --- Password recovery e-mail ---------------------------------------------------------------
# Without SMTP_HOST the reset code is printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Alba <no-reply@example.org>

# --- Mobile app (apps/mobile/.env) ----------------------------------------------------------
# Base URL of the API. On a physical phone use your computer's LAN IP, never "localhost".
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
