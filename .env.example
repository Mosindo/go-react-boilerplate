# ---------------------------------------------------------------------------
# Lueur API configuration. Copy to .env and fill in the secrets.
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# development | production. In development, password reset codes are printed
# in the API logs when SMTP is not configured.
APP_ENV=development

# HTTP port inside the container / process.
PORT=8080

# PostgreSQL connection string (docker compose builds it from POSTGRES_PASSWORD).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=postgres

# REQUIRED. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Optional dedicated key for signed photo URLs (defaults to a key derived
# from JWT_SECRET). At least 32 random characters when set.
MEDIA_SIGNING_SECRET=

# Where uploaded photos are stored on disk.
MEDIA_DIR=./data/media

# Comma separated browser origins allowed by CORS (Expo web, admin...).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted.
# Leave empty when the API is reached directly.
TRUSTED_PROXIES=

# SMTP relay used for password reset e-mails (optional in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
