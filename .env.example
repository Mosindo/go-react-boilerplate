# Copy to .env and fill in. Never commit the real file.

# --- Database (docker compose) ---------------------------------------------
POSTGRES_USER=ember
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=ember

# --- API -------------------------------------------------------------------
# Required. Generate with: openssl rand -hex 32  (>= 32 chars, not a placeholder)
JWT_SECRET=
# development | production. In production the log-only mailer is disabled.
APP_ENV=development
# Host port the API is published on (the container always listens on 8080).
API_HOST_PORT=18080
# Comma separated browser origins allowed by CORS / WebSocket (not needed for native apps).
ALLOWED_ORIGINS=
# Comma separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXIES=

# Running the API outside Docker (go run ./cmd/api):
# DATABASE_URL=postgres://ember:change-this-database-password@localhost:5432/ember?sslmode=disable
# PORT=8080
# UPLOAD_DIR=./data/uploads

# --- Password recovery e-mail (optional in development) ----------------------
# Without SMTP, development logs the recovery code in the API log; production sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile app (apps/mobile/.env or shell) ----------------------------------
# Physical phone: use your computer's LAN IP, never localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
