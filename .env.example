# Copy to .env and fill in. Never commit .env.

# --- API (required) ---
# Generate with: openssl rand -hex 32   (minimum 32 characters)
JWT_SECRET=
# Used when running the API outside Docker. Docker Compose sets its own.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# --- API (optional) ---
PORT=8080
# development | production. "production" disables the demo seed.
APP_ENV=development
# Where processed photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS / WebSocket (web client only).
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting).
# Leave empty unless the API sits behind your own reverse proxy / load balancer.
TRUSTED_PROXIES=

# --- Mobile (apps/mobile) ---
# Physical phone: http://<LAN_IP>:18080 (never localhost). Emulators have defaults.
EXPO_PUBLIC_API_URL=http://localhost:18080
