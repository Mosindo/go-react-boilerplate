# Copy to .env and adjust. Never commit the real file.

# --- API ---------------------------------------------------------------
# development | production | test. Production disables the log mailer.
APP_ENV=development
PORT=8080
# Required: random secret, >= 32 chars (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Host port exposed by docker compose for the API.
API_HOST_PORT=18080
# Comma separated web origins allowed by CORS / WebSocket (leave empty for native-only).
ALLOWED_ORIGINS=
# Where processed photos are stored (docker: /data/uploads volume).
UPLOAD_DIR=./data/uploads
# Product name used in emails.
APP_NAME=Lumen

# --- Database ----------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST_PORT=5432
# Used by `go run ./cmd/api` outside Docker (compose builds its own).
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Integration tests create throwaway schemas in this database.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# --- Email (password recovery) -----------------------------------------
# Without SMTP_HOST, development prints recovery codes in the API log and
# production disables recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile (apps/mobile/.env or shell) --------------------------------
# Use your machine's LAN IP for a physical phone, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:18080
