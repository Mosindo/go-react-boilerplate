# Copy to .env (never commit .env). Used by docker-compose and as a reference for local runs.

# --- API (required) ---------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Local (non-Docker) runs only; docker-compose builds this URL itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# --- API (optional) ---------------------------------------------------------
PORT=8080
# development | test | production. production requires SMTP_HOST and disables the log mailer.
APP_ENV=development
# Comma-separated browser origins allowed by CORS (only needed for the web build), e.g. http://localhost:8081
ALLOWED_ORIGINS=
# Comma-separated trusted reverse-proxy IPs/CIDRs so client IPs (rate limiting) come from X-Forwarded-For.
TRUSTED_PROXIES=
# Prefix of the deep link in password-reset e-mails.
APP_LINK_BASE=ember://

# SMTP for password recovery. Without SMTP_HOST, e-mails are printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker Compose ---------------------------------------------------------
POSTGRES_PASSWORD=postgres
API_HOST_PORT=18080

# --- Mobile: see apps/mobile/.env.example (EXPO_PUBLIC_API_URL) ----------------
