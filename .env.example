# Copy to .env (never commit .env). Docker Compose reads this file automatically.

# --- API ---------------------------------------------------------------------
# development | test | production. Production hides demo profiles, discards
# password-reset emails when SMTP is missing and enables Gin release mode.
APP_ENV=development
# Required. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
PORT=8080
# Used when running the API outside Docker (go run ./cmd/api).
DATABASE_URL=postgres://lueur:lueur-local-only@localhost:5432/lueur?sslmode=disable
# Where uploaded photos are stored (local disk). Mounted as a volume in Docker.
UPLOAD_DIR=./data/uploads
# Comma-separated web origins allowed by CORS (the native app needs none).
ALLOWED_ORIGINS=http://localhost:8081
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=

# --- Account recovery emails (optional in development) ------------------------
# Without SMTP, development prints reset codes in the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Postgres container (docker compose) ------------------------------------
POSTGRES_USER=lueur
POSTGRES_PASSWORD=lueur-local-only
POSTGRES_DB=lueur

# --- Demo seed (go run ./cmd/seed, never in production) ----------------------
SEED_LAT=48.8566
SEED_LNG=2.3522
SEED_PASSWORD=DemoLueur2026

# --- Mobile app (apps/mobile/.env) -------------------------------------------
# Public URL of the API as seen from the device. On a physical phone use the
# LAN IP of your computer, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
