# Copy to .env and adapt. Never commit the real file.

# --- API (required) ---------------------------------------------------------
# Random secret, at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Postgres connection string (the Docker stack builds its own from POSTGRES_*).
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# --- API (optional) ---------------------------------------------------------
# development | production. Production requires SMTP_HOST (password recovery emails).
APP_ENV=development
PORT=8080
# Where photos are stored on disk. Back this directory up / mount a volume in production.
UPLOAD_DIR=./data/uploads
# Comma separated browser origins allowed by CORS and WebSocket (native apps need none).
ALLOWED_ORIGINS=
# Comma separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted
# (rate limiting uses the client IP). Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# --- Password recovery email ------------------------------------------------
# Without SMTP_HOST (development only) reset codes are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker stack -----------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
API_HOST_PORT=18080

# --- Demo data (`make seed`, development only) ------------------------------
SEED_PASSWORD=demo-password-123

# --- Mobile app (read by Expo at build/start time, apps/mobile) -------------
# Use the LAN IP of the machine running the API when testing on a physical phone:
# a phone can never reach "localhost" on your computer.
EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
