# ---- Required ---------------------------------------------------------------
# Strong random secret, >= 32 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Used by docker compose for the bundled Postgres (change it outside local dev).
POSTGRES_PASSWORD=ember

# ---- Backend (services/api) --------------------------------------------------
# Not needed with docker compose (it builds DATABASE_URL); needed for `go run ./cmd/api`.
DATABASE_URL=postgres://ember:ember@localhost:5432/ember?sslmode=disable
PORT=8080
# development | production. Production requires SMTP_HOST and disables the demo seed.
APP_ENV=development
# Where processed photos are stored (a docker volume in compose). Never served statically.
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS / WebSocket (web builds only; native apps send no Origin).
ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For can be trusted (used by rate limiting).
TRUSTED_PROXIES=

# ---- Account recovery e-mail (optional in development) -------------------------
# Without SMTP_HOST the recovery code is printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Mobile (apps/mobile/.env or shell) ------------------------------------------
# Physical phone: use your computer's LAN IP, never localhost. Example: http://192.168.1.20:18080
EXPO_PUBLIC_API_URL=http://localhost:18080
