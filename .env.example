# Copy to .env (never commit it). docker compose reads it automatically.

# REQUIRED. Random secret of 32+ characters, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- API (defaults shown) ---
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app?sslmode=disable

# Browser origins allowed for CORS / WebSocket (comma separated). Native apps need nothing here.
ALLOWED_ORIGINS=

# Comma separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty when the API is exposed directly; set it behind a proxy so rate limits see real client IPs.
TRUSTED_PROXIES=

# Rate limits per minute: unauthenticated /auth/* per IP, and authenticated traffic per user.
AUTH_RATE_PER_MINUTE=20
API_RATE_PER_MINUTE=600

# --- Outgoing e-mail for password reset codes ---
# Leave SMTP_HOST empty in development: codes are then printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile app (apps/mobile/.env or shell) ---
# Never "localhost" on a physical phone: use your computer's LAN IP and the host port of the API.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080

# --- Demo data (development only, see README "Seed") ---
# ALLOW_DEMO_SEED=true
# DEMO_PASSWORD=DemoPass123
