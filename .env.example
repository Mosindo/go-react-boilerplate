# Copy to `.env` (never commit it). Docker Compose and the API read these variables.

# --- Required -----------------------------------------------------------------------------------
# Long random string used to sign access tokens and photo URLs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL credentials used by docker-compose (the API container builds DATABASE_URL from them).
POSTGRES_USER=alma
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=alma

# When running the API outside Docker, point it at your database:
# DATABASE_URL=postgres://alma:<password>@localhost:5432/alma?sslmode=disable

# --- Optional -----------------------------------------------------------------------------------
# development (default) | production. Production requires SMTP_HOST and refuses the demo seed.
APP_ENV=development
PORT=8080

# Where photos are stored (mounted as a volume in docker-compose).
UPLOAD_DIR=./data/uploads

# Browser origins allowed to call the API (web build only, comma separated).
ALLOWED_ORIGINS=http://localhost:8081

# Reverse proxies whose X-Forwarded-For is trusted (CIDR or IP, comma separated). Leave empty when
# the API is exposed directly: rate limiting then uses the real peer address.
TRUSTED_PROXIES=

# Outgoing mail for password recovery. Without SMTP_HOST (development only) the code is printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example

# Host port of the API container. 18080 avoids clashes with other local services.
API_HOST_PORT=18080
