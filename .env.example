# --- API (services/api) -------------------------------------------------------
# Required. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Required outside Docker (docker-compose injects its own value).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080
# development | production. Production requires SMTP_* and disables the demo seed.
APP_ENV=development
# Where processed photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma separated web origins allowed by CORS / WebSocket (native apps need none).
ALLOWED_ORIGINS=
# Comma separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the client IP).
TRUSTED_PROXIES=

# Password-reset e-mails. Leave SMTP_HOST empty in development to print codes in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Demo data (cmd/seed, development only) ----------------------------------
SEED_PASSWORD=
SEED_LAT=48.8566
SEED_LNG=2.3522

# --- Mobile (apps/mobile) -----------------------------------------------------
# Never use localhost on a physical phone: use your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://<LAN_IP>:18080
