# ---------------------------------------------------------------------------
# API (services/api) — read by `docker compose` and by `go run ./cmd/api`.
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# development | test | production. Production hides demo accounts, disables
# the dev log mailer and switches Gin to release mode.
APP_ENV=development

# REQUIRED. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# HTTP port inside the container / process (Docker exposes it on 18080).
PORT=8080

# REQUIRED when running the API outside Docker.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable
# Postgres password used by docker compose.
POSTGRES_PASSWORD=app

# Optional separate database for `go test ./...` integration tests.
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/app_test?sslmode=disable

# Where uploaded photos are stored (local disk).
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS / WebSocket (Expo web).
# Native apps send no Origin header and are not affected.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty
# when the API is exposed directly; otherwise rate limits could be bypassed.
TRUSTED_PROXIES=

# SMTP for password reset emails. When empty: codes are printed in the API
# logs in development, and emails are dropped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Password for demo accounts created by `go run ./cmd/seed` (dev only).
SEED_PASSWORD=DemoPassword1

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — copy to apps/mobile/.env. EXPO_PUBLIC_* values are
# embedded in the client bundle: never put secrets here.
# ---------------------------------------------------------------------------
# Physical phone: use your LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:18080
