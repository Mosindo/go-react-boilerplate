# ---------------------------------------------------------------------------
# Lueur API configuration. Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# development | test | production (default: production).
# In development, password recovery codes are printed to the API log when SMTP
# is not configured. Never use development in production.
APP_ENV=development

# Required. Generate with: openssl rand -base64 48  (min 32 characters)
JWT_SECRET=

# Optional. Key used to sign photo URLs (min 32 chars). Derived from JWT_SECRET when empty.
MEDIA_SIGNING_SECRET=

# HTTP port inside the container / process.
PORT=8080

# PostgreSQL connection string. Docker Compose builds it automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=postgres

# Directory where processed photos are stored (mounted as a volume in Docker).
UPLOAD_DIR=./data/uploads

# Comma separated list of browser origins allowed by CORS (web client), e.g.
# http://localhost:8081. Leave empty for native mobile clients only.
ALLOWED_ORIGINS=http://localhost:8081

# Reverse proxies allowed to set X-Forwarded-For (CSV of IPs/CIDRs). Leave empty
# when the API is exposed directly; set it behind a load balancer so rate
# limiting sees real client IPs.
TRUSTED_PROXIES=

# Expose the generic boilerplate modules (users directory, posts, comments,
# file metadata). Not used by the dating app: keep false in production.
ENABLE_COMMUNITY_MODULES=false

# SMTP relay for password recovery emails (STARTTLS). Leave SMTP_HOST empty to
# disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
