# Copy to .env (never commit .env). Docker Compose reads it automatically.

# development | production. In development, password-reset codes are printed
# to the API log when SMTP is not configured; in production they never are.
APP_ENV=development

# REQUIRED. 32+ random characters, e.g. `openssl rand -hex 32`.
# Signs access tokens, media URLs and password-reset codes.
JWT_SECRET=

# API port inside the container (published on host port 18080 by compose).
PORT=8080

# Used when running the API outside Docker (go run ./cmd/api).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
POSTGRES_PASSWORD=postgres

# Where processed photos are stored (a Docker volume in compose).
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS / WebSocket (web client only;
# native apps need nothing). Example: http://localhost:8081
ALLOWED_ORIGINS=

# Comma-separated reverse proxies / CIDRs allowed to set X-Forwarded-For.
# Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# Optional SMTP for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
