# ---- API (services/api) -------------------------------------------------
# Generate with: openssl rand -hex 32   (never commit the real value)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app?sslmode=disable

# "development" (default) logs password-recovery codes to the API log.
# "production" requires SMTP_HOST and forbids RATE_LIMIT=off.
APP_ENV=development
APP_NAME=Lumen

# Where uploaded (re-encoded) photos live. Mount a persistent volume in production.
UPLOAD_DIR=./data/uploads

# Browser origins allowed by CORS (comma separated). Empty: no cross-origin access.
ALLOWED_ORIGINS=
# Reverse proxies whose X-Forwarded-For you trust (comma separated IPs/CIDRs). Empty: none.
TRUSTED_PROXIES=

# Rate limiting is ON by default. "off" is only accepted outside production.
RATE_LIMIT=on

# Password recovery e-mails. Leave SMTP_HOST empty in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Mobile app (apps/mobile) -------------------------------------------
# Use your computer's LAN IP on a physical phone, never "localhost".
# EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
