# Copy to .env and adjust. Never commit the real file.

# --- Required -------------------------------------------------------------
# Strong random secret, 32+ characters:  openssl rand -hex 32
JWT_SECRET=

# --- Runtime --------------------------------------------------------------
# development | test | production. Production refuses to start without SMTP_*.
APP_ENV=development
PORT=8080

# Used by docker compose (the api service builds its own DATABASE_URL from it).
POSTGRES_PASSWORD=app

# For `go run ./cmd/api` outside Docker:
# DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Where private photo files are stored (a Docker volume in compose).
# UPLOAD_DIR=./data/uploads

# --- Network / security ------------------------------------------------------
# Comma-separated browser origins allowed by CORS (leave empty for native-only clients).
ALLOWED_ORIGINS=
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For is trusted
# (rate limiting is per client IP). Leave empty when the API is exposed directly.
TRUSTED_PROXIES=

# --- Email (password recovery) -------------------------------------------------
# Required when APP_ENV=production. In development, codes are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mobile app (apps/mobile) -------------------------------------------------
# A physical phone cannot reach "localhost": use the LAN IP of the machine running the API.
# EXPO_PUBLIC_API_URL=http://<LAN_IP>:18080
