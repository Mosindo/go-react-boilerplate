# Copy to .env and fill in. Never commit .env.

# --- API -------------------------------------------------------------------
# development | test | production (production requires SMTP_* for password reset)
APP_ENV=development
# 32+ random characters, e.g. `openssl rand -base64 48`. Placeholders are rejected.
JWT_SECRET=
# Port the API listens on inside its container / process.
PORT=8080
# Only needed when running the API outside Docker Compose.
DATABASE_URL=postgres://lueur:CHANGE_ME@localhost:5432/lueur?sslmode=disable
# Directory where processed photos are stored (mounted volume in Docker).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS/WebSocket (web build), e.g. https://app.example.org
ALLOWED_ORIGINS=http://localhost:8081
# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXIES=

# --- E-mail (password reset codes). Without SMTP_HOST, codes are written to the API log (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Docker Compose PostgreSQL ---------------------------------------------
POSTGRES_USER=lueur
POSTGRES_PASSWORD=
POSTGRES_DB=lueur

# --- Demo seed (optional) ----------------------------------------------------
# Password given to demo accounts created by `seed --yes-demo`. Random if empty.
SEED_DEMO_PASSWORD=
