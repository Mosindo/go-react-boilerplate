# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- Required ---------------------------------------------------------------
# Random secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Placeholder-looking values are rejected at startup.
JWT_SECRET=

# --- API --------------------------------------------------------------------
# development | test | production. In production: demo profiles are hidden,
# the seed command refuses to run and password reset codes are never logged.
APP_ENV=development
PORT=8080
# Only needed when running the API outside Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable
# Compose-only: password of the bundled Postgres.
POSTGRES_PASSWORD=postgres
# Where photos are stored (a Docker volume in Compose).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS (web build), e.g.
# http://localhost:8081. Native apps do not need it.
ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (needed for
# correct client IPs and rate limiting behind a load balancer).
TRUSTED_PROXIES=

# --- E-mail (password reset) ---------------------------------------------------
# Without SMTP: codes are printed in the API logs in development and dropped
# in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Demo data (cmd/seed) ----------------------------------------------------
# Password of the generated demo accounts (default: DemoLueur2026).
SEED_PASSWORD=
