# ---- API (read by docker compose and by the Go binary) ----
# Required. Random string, 32+ characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Compose builds DATABASE_URL from this; set a real password anywhere but local dev.
POSTGRES_PASSWORD=postgres

# Used by the binary when run outside compose.
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?sslmode=disable
# Where processed photos are stored. Back this directory up and mount it as a volume.
UPLOADS_DIR=./data/uploads

# ---- Networking ----
# Comma-separated browser origins allowed by CORS (leave empty for native-only clients).
ALLOWED_ORIGINS=
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For is trusted. Needed in
# production behind a load balancer so rate limiting sees real client IPs; leave empty otherwise.
TRUSTED_PROXIES=
APP_BASE_URL=http://localhost:18080

# ---- Email (password recovery) ----
# Leave SMTP_HOST empty in development: recovery codes are then written to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# ---- Seeding (development only; refused when APP_ENV=production) ----
APP_ENV=development
SEED_PASSWORD=DemoPassword1!

# ---- Tests ----
# Optional. When set, Go integration tests run against this database (they create and delete their own users).
DATABASE_URL_TEST=
