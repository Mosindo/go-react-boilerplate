# ---------------------------------------------------------------------------
# Lueur API — copy to .env (never commit .env) and adjust.
# docker compose reads this file automatically from the repository root.
# ---------------------------------------------------------------------------

# development | production. In production: demo profiles are hidden, Gin runs
# in release mode and recovery emails are only sent through SMTP.
APP_ENV=development

# REQUIRED. 32+ random characters, e.g. `openssl rand -hex 32`.
# Signs access tokens and derives the photo URL signing key.
JWT_SECRET=

# Only needed when running the API outside Docker (compose sets it itself).
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable
PORT=8080

# Where photos are stored on disk (compose mounts a named volume).
UPLOAD_DIR=./data/uploads

# Browser origins allowed by CORS (comma-separated). Native apps need none.
ALLOWED_ORIGINS=http://localhost:8081

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs/CIDRs).
# Leave empty when the API is exposed directly; rate limiting uses the client IP.
TRUSTED_PROXIES=

# Optional SMTP relay for password recovery codes. Without it, codes are
# printed in the API logs in development and dropped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Host ports used by docker compose.
API_HOST_PORT=18080
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — public values only, embedded in the bundle.
# Physical phone: use your computer's LAN IP, never localhost.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:18080
