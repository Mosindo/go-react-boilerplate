# ---- API (services/api) ----------------------------------------------------
# Required. Generate with: openssl rand -hex 32   (>= 32 chars, not a placeholder)
JWT_SECRET=
# Required outside docker-compose. Compose builds it for you from POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080

# Where processed photos are stored. Use a persistent volume in production.
UPLOAD_DIR=./data/uploads

# Comma-separated browser origins allowed by CORS and WebSocket (web build only; native apps need none).
ALLOWED_ORIGINS=
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted (e.g. 10.0.0.0/8). Empty = trust nobody.
TRUSTED_PROXIES=

# Public URL of the app, used in password-reset emails (optional).
APP_BASE_URL=

# Email for password recovery. Without SMTP_HOST, emails are printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Docker Compose only
POSTGRES_PASSWORD=postgres

# Set to "production" to make `cmd/seed` refuse to run.
APP_ENV=development

# ---- Mobile (apps/mobile) --------------------------------------------------
# Public API base URL. On a physical phone use your machine's LAN IP, never localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
# This value is bundled into the app: never put a secret in it.
EXPO_PUBLIC_API_URL=http://localhost:18080
