# Copy to `.env` (never commit it). Docker Compose reads this file automatically.

# --- API (required) ---------------------------------------------------------
# Generate with: openssl rand -hex 32   (>= 32 chars, placeholders are rejected)
JWT_SECRET=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
PORT=8080

# --- API (optional) ---------------------------------------------------------
# development | production. Production requires SMTP_* and disables the demo seed.
APP_ENV=development
# Where processed profile photos are stored (mount a persistent volume in production).
UPLOAD_DIR=./data/uploads
# Comma-separated browser origins allowed by CORS / WebSocket (web builds only).
ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=

# Password-recovery email. Without SMTP_HOST the code is printed in the API log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Test database used by `go test ./...` for the integration suite (tests skip when unset).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/app_test?sslmode=disable

# --- Mobile app (public values only - never put secrets here) ---------------
# Physical phone: use your computer's LAN IP, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
