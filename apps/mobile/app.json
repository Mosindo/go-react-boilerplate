{
  "expo": {
    "name": "Hearth",
    "slug": "hearth",
    "scheme": "hearth",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14110F",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hearth.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hearth.mobile",
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "blockedPermissions": ["ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Hearth",
      "themeColor": "#14110F",
      "backgroundColor": "#14110F"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hearth a besoin d'accéder à tes photos pour que tu puisses les ajouter à ton profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hearth utilise ta position approximative (arrondie à ~1 km) pour te proposer des personnes près de toi. Elle n'est jamais partagée.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ]
  }
}
