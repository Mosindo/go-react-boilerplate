{
  "expo": {
    "name": "Lueur",
    "slug": "lueur",
    "scheme": "lueur",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14111A",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lueur.mobile"
    },
    "android": {
      "package": "app.lueur.mobile",
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "blockedPermissions": ["ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Lueur a besoin d'accéder à vos photos pour que vous puissiez les ajouter à votre profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lueur utilise une position approximative pour vous proposer des personnes proches. Votre position exacte n'est jamais partagée."
        }
      ],
      "expo-secure-store"
    ]
  }
}
