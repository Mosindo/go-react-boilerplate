{
  "name": "lueur-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:phone": "node ./scripts/start-phone.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.mjs\" App.tsx",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.mjs\" App.tsx",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/__tests__/*.test.ts\"",
    "build:web": "expo export --platform web --output-dir dist",
    "e2e:api": "node e2e/api-smoke.mjs",
    "e2e:web": "node e2e/web/critical-flow.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.90.5",
    "expo": "~54.0.33",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
