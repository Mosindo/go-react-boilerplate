{
  "name": "amora-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:phone": "node ./scripts/start-phone.js",
    "e2e:smoke": "node ./scripts/e2e-smoke.js",
    "e2e:ui:setup": "node ./scripts/e2e-ui-setup.js",
    "e2e:ui:run": "powershell -ExecutionPolicy Bypass -File ./scripts/run-maestro.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e:web": "node ./e2e/web/journey.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tamagui/babel-plugin": "^2.0.0-rc.25",
    "@tanstack/react-query": "^5.90.5",
    "expo": "~54.0.33",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.3",
    "tamagui": "^2.0.0-rc.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "babel-preset-expo": "^55.0.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
