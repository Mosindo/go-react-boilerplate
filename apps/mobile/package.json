    "@tanstack/react-query": "^5.90.5",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
