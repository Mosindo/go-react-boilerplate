{
  "name": "lien-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:phone": "node ./scripts/start-phone.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{App,src}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{App,src}/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "e2e:smoke": "node ./scripts/e2e-smoke.js",
    "e2e:ui:setup": "node ./scripts/e2e-ui-setup.js",
    "e2e:ui:run": "bash ./scripts/run-maestro.sh",
    "e2e:ui:run:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/run-maestro.ps1",
    "e2e:web": "node ./e2e/web/journey.cjs",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.90.5",
    "expo": "~54.0.33",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^55.0.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
