# Base URL of the Lumen API, without a trailing slash.
#
# NEVER use "localhost" when testing on a physical phone: it points at the phone itself.
# Use your computer's LAN IP and the host port published by docker compose (default 18080):
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:18080
#
# Emulators only (used automatically in development when this is unset):
#   Android emulator -> http://10.0.2.2:18080
#   iOS simulator    -> http://localhost:18080
#
# Never put secrets here: EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_API_URL=http://<LAN_IP>:18080
