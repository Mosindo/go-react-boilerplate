# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values are embedded in the app:
# never put a secret here.

# URL of the API. On a physical phone use your computer's LAN IP, never
# localhost (e.g. http://192.168.1.20:18080). `npm run start:phone` sets it.
# Android emulators can use http://10.0.2.2:18080.
EXPO_PUBLIC_API_URL=http://localhost:18080
