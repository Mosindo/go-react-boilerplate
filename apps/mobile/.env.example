# Base URL of the Lueur API, without a trailing slash.
#
# - Physical phone: NEVER use localhost (it is the phone itself). Use the LAN IP of the machine running the API,
#   e.g. http://192.168.1.42:18080 (phone and computer on the same Wi-Fi). `npm run start:phone` detects it for you.
# - Android emulator: http://10.0.2.2:18080 (the default in development when this variable is unset).
# - iOS simulator: http://localhost:18080 (the default in development when this variable is unset).
# - Production builds: this variable is required (HTTPS).
EXPO_PUBLIC_API_URL=http://192.168.1.42:18080
