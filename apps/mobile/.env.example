# Public build-time variable (it is embedded in the app: never put a secret here).
# Browser / iOS simulator on the same machine:  http://localhost:18080
# Android emulator:                              http://10.0.2.2:18080
# Physical phone (same Wi-Fi):                   http://<LAN_IP>:18080   (never localhost)
EXPO_PUBLIC_API_URL=http://localhost:18080
