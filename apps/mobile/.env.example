# Base URL of the Lumo API (no trailing slash).
#  - iOS simulator / web dev: http://localhost:18080
#  - Android emulator:        http://10.0.2.2:18080
#  - Physical phone:          http://<LAN_IP>:18080  (never localhost)
# When unset in development, the app falls back to localhost:18080 (10.0.2.2 on Android).
EXPO_PUBLIC_API_URL=http://localhost:18080
