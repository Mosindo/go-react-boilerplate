# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* variables reach the app bundle:
# never put a secret here.

# API base URL. Physical phone: use your computer's LAN IP, never localhost.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:18080
# Android emulator: http://10.0.2.2:18080 — iOS simulator / web: http://localhost:18080
EXPO_PUBLIC_API_URL=http://localhost:18080
